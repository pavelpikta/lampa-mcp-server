{
  "name": "lampa-mcp-server",
  "version": "1.9.2",
  "description": "MCP server for Lampa source repository development assistance (local stdio + Cloudflare Workers)",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pavelpikta/lampa-mcp-server.git"
  },
  "bin": {
    "lampa-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "npm run types:worker && tsc -p tsconfig.build.json",
    "dev": "npm run build && npm start",
    "start": "node dist/index.js",
    "typecheck": "npm run types:worker && tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src scripts",
    "format:check": "prettier --check src scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "types:worker": "wrangler types",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy",
    "snapshot:upload": "node scripts/upload-snapshot.mjs",
    "snapshot:upload:local": "node scripts/upload-snapshot.mjs --local",
    "release": "semantic-release"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.10.2",
    "@modelcontextprotocol/server": "^2.0.0",
    "agents": "^0.22.0",
    "hono": "^4.13.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/npm": "^13.1.3",
    "@types/node": "^26.4.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.127.1"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "core-js-pure@3.50.0": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "workerd@1.20260801.1": true
  }
}
