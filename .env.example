# Path to your checked-out Lampa source repository (local stdio mode)
LAMPA_REPO_PATH=/path/to/lampa-source

# Cloudflare Worker (set in wrangler.jsonc vars, dashboard, or `.dev.vars`)
# ALLOWED_GITHUB_USERS=your-login,coworker
#
# Clients authenticate with a GitHub PAT (Bearer), not OAuth App secrets.
# Create a token with read:user — do not commit the PAT here.
